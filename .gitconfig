# -*- mode: gitconfig -*-
# -*- eval: (indent-tabs-mode 1) -*-

[github]
	user = qdw

[user]
	email = quinn.weaver@gmail.com
	name = Quinn Weaver

[includeIf "gitdir:~/upst"]
	path = ~/.upstart-gitconfig

[includeif "gitdir:blue-shaper"]
	path = ~/.blue-shaper-gitconfig



[blame]
	coloring = highlightRecent

[color "diff"]
	meta = magenta
	old = "#ac4d4d"
	new = "#3b8560"
	oldMoved = brightblack
	newMoved = brightblue
	oldMovedAlternative = cyan
	newMovedAlternative = brightcyan

[color "blame"]
	highlightRecent = 22,6.months.ago,28,3.months.ago,34,6.weeks.ago,40,3.weeks.ago,47,10.days.ago,120

[core]
	excludesfile = ~/.gitignore
	ignorecase = false
	## whitespace = space-before-tab,tab-in-indent
	
## [log]
	## ignoreAllSpace
	## ignoreSpaceAtEol

[diff]
	## ignoreBlankLines
	## ignoreSpaceAtEol
	algorithm = patience
	color = auto
	colorMoved = dimmed-zebra
	## difft: semantic diff that understands various programming languages
	## tool = difft #--background dark --color always --missing-as-empty --skip-unchanged


[difftool]
	prompt = false
	
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
	
[pager]
	difftool = true

[merge]
	tool = emerge
	renamelimit = 10500

[alias]
	added = diff --diff-filter=A	
	branch = branch --quiet
	ch = "!function _ch { git diff \"${1}^\" \"${1}\" ;}; _ch "
	char-diff = diff --word-diff-regex=.
	co = switch
	coml = "!function _nol { COMMIT=${1:HEAD}; git diff --compact-summary \"${COMMIT}^\" \"${COMMIT}\" ;}; _nol "
	comp = diff --compact-summary
	delete-remote-branch = push origin --delete
	diff-remote = diff @{u}
	diff-remote-committed = diff @{u} HEAD
	dr = "!git diff  \"origin/$(git branch --show-current)\"  \"$(git branch --show-current)\"  "
	dry = merge --no-commit --no-ff
	ff = pull --ff-only
	ignored = "!ig() { /bin/echo -n \"$1\" 'is'; git check-ignore --quiet \"$1\"; if [[ $? = 1 ]]; then /bin/echo -n ' not'; fi; /bin/echo ' ignored by git'; }; ig"
	last = "!f() { git diff ${1:-HEAD}^ ${1:-HEAD}; }; f"
	main = "!sh -c 'git checkout `/Users/quinn.weaver/.gitconfig-helper--get-main-branch-name`'"
	mm = commit --allow-empty-message -m ''
	no = diff --name-only
	nol = "!function _nol { git last "$@" --name-only ;}; _nol "
	report = log --pretty='----------------------------------------------------------------------------%n%s%w(0,4,4)%b' --author "Quinn|qdw"
	s = status
	stat = status
	tg = "!function _tg { git tag | sort -g ;}; _tg"
	tree = log --graph --decorate --pretty=oneline --abbrev-commit
	try = "!f() { git add . && git commit --allow-empty-message -m '' && git push; }; f"
	unadd = restore --staged
	weekly-report = log --since='7 days' --pretty='----------------------------------------------------------------------------%n%s%w(0,4,4)%b' --author "Quinn|qdw"

[init]
	defaultBranch = main

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[push]
	autoSetupRemote = on

[advice]
	diverging = false
