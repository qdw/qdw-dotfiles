          yellow  "#cdcd00"
   bright-yellow  "#ffff00"
            blue  "#0000ee"
     bright-blue  "#5c5cff"
         magenta  "#cd00cd"
  bright-magenta  "#ff00ff"
            cyan  "#00cdcd"
     bright-cyan  "#00ffff"
           white  "#353535"
    bright-white  "#ffffff"
