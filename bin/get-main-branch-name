#!/usr/bin/env fish

set BRANCH_NAMES (command git branch --remotes | command ggrep --perl-regexp --only-matching '  origin/HEAD -> origin/(?=master|main)\K.*$')
if test (count $BRANCH_NAMES) -gt 1
   echo "error: you should only have one HEAD, but you have '$BRANCH_NAMES'"
else
   echo $BRANCH_NAMES
end
