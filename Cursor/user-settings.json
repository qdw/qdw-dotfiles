{
    "window.commandCenter": true,
    "editor.fontFamily": "Menlo",
    "editor.cursorStyle": "block",
    "cursor.chat.terminalShowHoverHint": false,
    "cursor.composer.shouldAllowCustomModes": true,
    "cursor.composer.shouldAutoAcceptDiffs": false,
    "cursor.composer.shouldAutoScrollToBottom": false,
    "cursor.composer.shouldQueueWhenGenerating": true,
    "cursor.diffs.useCharacterLevelDiffs": true,
    "cursor.terminal.usePreviewBox": true,
    "editor.autoClosingDelete": "never",
    "emacs-mcx.emacsLikeTab": true,
    "emacs-mcx.cursorMoveOnFindWidget": true,
    "emacs-mcx.strictEmacsMove": true,
    "emacs-mcx.useMetaPrefixEscape": true,
    "git.openRepositoryInParentFolders": "never",
    "editor.codeLensFontSize": 6,
    "editor.inlayHints.fontSize": 17,
    "editor.minimap.sectionHeaderFontSize": 17,
    "debug.console.fontSize": 17,
    "scm.inputFontSize": 17,
    "terminal.integrated.fontSize": 17,
    "notebook.markup.fontSize": 17,
    "notebook.output.fontSize": 17,
    "chat.editor.fontSize": 17,
    "markdown.preview.fontSize": 17,
    "editor.suggestFontSize": 17,
    "screencastMode.fontSize": 20,
    "workbench.preferredDarkColorTheme": "Cursor Dark Midnight",
    "workbench.colorCustomizations": {
      "editor.lineHighlightBackground": "#ffffff0a",
      "editorLineNumber.foreground": "#666666",
      "editor.selectionBackground": "#4bbfc440",
      "editor.selectionHighlightBackground": "#5172d320",
      "editor.wordHighlightBackground": "#3b856030",
      "editor.wordHighlightStrongBackground": "#9164ff30",
      "editorHoverWidget.foreground": "#ff7f00",
      "editor.background": "#000000",
      "editor.foreground": "#af5faf",
      "editorCursor.foreground": "#d8a0d0",
      "terminal.background": "#000000",
      "terminal.foreground": "#af5faf",
      "terminal.ansiBlack": "#000000",
      "terminal.ansiRed": "#af5f00",
      "terminal.ansiGreen": "#00a700",
      "terminal.ansiYellow": "#b5b500",
      "terminal.ansiBlue": "#5172d3",
      "terminal.ansiMagenta": "#d8a0d0",
      "terminal.ansiCyan": "#4bbfc4",
      "terminal.ansiWhite": "#767676",
      "terminal.ansiBrightBlack": "#343434",
      "terminal.ansiBrightRed": "#ff7f00",
      "terminal.ansiBrightGreen": "#3b8560",
      "terminal.ansiBrightYellow": "#9164ff",
      "terminal.ansiBrightBlue": "#6495ed",
      "terminal.ansiBrightMagenta": "#af5faf",
      "terminal.ansiBrightCyan": "#028080",
      "terminal.ansiBrightWhite": "#767676",
      "activityBar.background": "#000000",
      "sideBar.background": "#000000",
      "sideBar.foreground": "#af5faf",
      "statusBar.background": "#000000",
      "statusBar.foreground": "#af5faf",
      "panel.background": "#000000",
      "panel.border": "#343434",
      "tab.activeBackground": "#343434",
      "tab.inactiveBackground": "#000000",
      "tab.activeForeground": "#af5faf",
      "tab.inactiveForeground": "#767676",
      "titleBar.activeBackground": "#000000",
      "titleBar.activeForeground": "#af5faf",
      "chat.messageBackground": "#000000",
      "chat.messageBorder": "#343434",
      "chat.userMessageBackground": "#3b8560",
      "chat.assistantMessageBackground": "#6495ed",
      "chat.userMessageForeground": "#000000",
      "chat.assistantMessageForeground": "#000000"
    },
    "editor.tokenColorCustomizations": {
      "textMateRules": [
        {
          "scope": "punctuation.definition.comment.python",
          "settings": { "foreground": "#028080" }
        },
        {
          "scope": "comment",
          "settings": { "foreground": "#af5f00", "fontStyle": "" }
        },
        {
          "scope": [
            "string",
            "string.double.quoted.python",
            "string.single.quoted.python",
            "punctuation.quoted",
            "punctuation.single",
            "punctuation.double"
          ],
          "settings": { "foreground": "#3b8560" }
        },
        {
          "scope": "variable",
          "settings": {
            "foreground": "#767676",
            "fontStyle": ""
          }
        },
        {
          "scope": "constant.language",
          "settings": { "foreground": "#ff7f00" }
        },
        {
          "scope": [
            "entity.name.function",
            "entity.name.function.python",
            "function.declaration",
            "meta.function",
            "meta.function.python",
            "entity.name.method",
            "entity.name.method.python",
            "entity.name.class",
            "entity.name.class.python",
          ],
          "settings": { "foreground": "#6495ed" }
        },
        {
          "scope": [
            "function",
            "meta.function-call.python",
            "meta.function-call.generic.python",
            "meta.function-call.arguments.python",
            "method",
            "meta.method",
            "meta.attribute.python",
            "meta.member.access.python",

            "entity.name.namespace",
            "entity.name.namespace.python",
            "support.module.python",

            "support.class",

            "variable.language.special",
            "variable.language.special.python",
            "variable.other.readwrite",
            "variable.other.readwrite.python",
            "constant",
            "constant.numeric"
          ],
          "settings": { "foreground": "#767676"}
        },
        {
          "scope": [
            "keyword",
            "storage.type.function",
            "storage.type.function.python"
          ],
          "settings": { "foreground": "#9164ff" }
        },
        {
          "scope": [
            "keyword.operator.arithmetic.python",
            "keyword.operator.assignment.python",
            "keyword.operator.bitwise.python",
            "keyword.operator.comparison.python",
            "keyword.operator.logical.python",
            "keyword.operator.word.python",
            "meta.annotation.python",
            "punctuation.section.braces.begin",
            "punctuation.section.braces.end",
            "punctuation.section.brackets.begin",
            "punctuation.section.brackets.end",
            "punctuation.section.parens.begin",
            "punctuation.section.parens.end",
            "punctuation.separator.period.python",
            "storage.name.class.python",
            "storage.name.function.python",
            "storage.type.class.python",
            "storage.type.function.python",
            "variable.parameter.function.python"
          ],
          "settings": { "foreground": "#767676" },
        }
        {
          "scope": "entity.name.type",
          "settings": { "foreground": "#af5faf" }
        },
        {
          "scope": "support.type.property-name",
          "settings": { "foreground": "#6495ed" }
        },
        {
          "scope": "support.type.property-name.json",
          "settings": { "foreground": "#6495ed" }
        },
      ]
    },
    "editor.semanticTokenColorCustomizations": {
      "rules": {
        "class": { "foreground": "#9164ff" },
        "function": { "foreground": "#6495ed" },
        "function.declaration": { "foreground": "#6495ed", "fontStyle": "italic" },
        "method": { "foreground": "#6495ed" },
        "keyword": { "foreground": "#9164ff" },
        "parameter": { "foreground:": "#767676" },
        "property": { "foreground": "#767676" },
        "string": { "foreground": "#3b8560"},
        "variable.readonly": { "foreground": "#767676" },
        "variable.defaultLibrary": { "foreground": "#767676" }
      }
    },
    "workbench.statusBar.visible": false,
    "cursor.experimental.inlineSuggest.enabled": false,
    "cursor.suggest.autoTrigger": false,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.inlineSuggest.enabled": false,
    "editor.inlineSuggest.showToolbar": "always",
    "editor.inlineSuggest.syntaxHighlightingEnabled": true,
    "editor.quickSuggestionsDelay": 50,
    "editor.quickSuggestions": {
      "comments": "off",
      "other": "off",
      "strings": "off"
    },
    "editor.screenReaderAnnounceInlineSuggestion": false,
    "editor.suggest.preview": false,
    "editor.suggest.shareSuggestSelections": false,
    "editor.cursorBlinking": "solid",
}