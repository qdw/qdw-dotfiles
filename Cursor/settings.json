    "editor.tokenColorCustomizations": {
      "textMateRules": [
        {
          "scope": "comment",
          "settings": { "foreground": "#af5f00", "fontStyle": "" }
        },
        {
          "scope": [
            "string",
            "string.double.quoted.python",
            "string.single.quoted.python",
            "punctuation.quoted",
            "punctuation.single",
            "punctuation.double"
          ],
          "settings": { "foreground": "#3b8560" }
        },
        {
          "scope": "variable",
          "settings": {
            "foreground": "#767676",
            "fontStyle": ""
          }
        },
        {
          "scope": [
            "constant.language",
            "constant.language.python"
          ],          
          "settings": { "foreground": "#ff7f00" }
        },
        {
          "scope": [
            "entity.name.function",
            "entity.name.function.python",
            "function.declaration",
            "meta.function",
            "meta.function.python",
            "meta.function-call.python",
            "meta.function-call.generic.python",
            "method",
            "meta.method",
            "entity.name.method",
            "entity.name.method.python",
            "variable.other.member",
            "variable.other.member.python",
            "variable.function",
            "variable.function.python",
            "entity.name.class",
            "entity.name.class.python",
            // "entity.name.class.builtin",
            // "entity.name.class.builtin.python",
            "support.function",
            "support.variable",
            "support.type",
            "source.python"
          ],
          "settings": { "foreground": "#6495ed" }
        },
        {
          "scope": [
            "variable.parameter.function-call.python",
            "meta.function-call.arguments.python",
            "meta.function.decorator.python"
          ],
          "settings": { "fontStyle": ""  }// "foreground": "#" }
        },
        {
          "scope": [
            "function",
            "meta.attribute.python",

            "entity.name.namespace",
            "entity.name.namespace.python",
            "support.module.python",

            "support.class",

            "variable.language.special",
            "variable.language.special.python",
            "variable.other.readwrite",
            "variable.other.readwrite.python",
            "constant",
            "constant.numeric"
          ],
          "settings": { "foreground": "#767676"}
        },
        {
          "scope": [
            "keyword",
            "storage.type.function",
            "storage.type.function.python"
          ],
          "settings": { "foreground": "#9164ff", "fontStyle": "" }
        },
        {
          "scope": [
            "keyword.operator.arithmetic.python",
            "keyword.operator.assignment.python",
            "keyword.operator.bitwise.python",
            "keyword.operator.comparison.python",
            "keyword.operator.logical.python",
            "keyword.operator.word.python",
            "meta.annotation.python",
            "punctuation.section.braces.begin",
            "punctuation.section.braces.end",
            "punctuation.section.brackets.begin",
            "punctuation.section.brackets.end",
            "punctuation.section.parens.begin",
            "punctuation.section.parens.end",
            "storage.name.class.python",
            "storage.name.function.python",
            "storage.type.class.python",
          ],
          "settings": { "foreground": "#767676", "fontStyle": "" }
        },
        {
          "scope": "entity.name.type",
          "settings": { "foreground": "#af5faf" }
        },
        {
          "scope": "support.type.property-name",
          "settings": { "foreground": "#6495ed" }
        },
        {
          "scope": "support.type.property-name.json",
          "settings": { "foreground": "#6495ed" }
        },
        {
          "scope": [
            "punctuation.definition.comment.python",
            "meta.function-call.arguments.python",
            "punctuation.separator",
            "punctuation.separator.python",
            "punctuation.separator.period",
            "punctuation.separator.period.python",
            "punctuation.separator.arguments",
            "punctuation.separator.arguments.python",

            // [
            "punctuation.definition.list.begin",
            "punctuation.definition.list.begin.python",

            // ]
            "punctuation.definition.list.end",
            "punctuation.definition.list.end.python",

            // (
            "punctuation.definition.arguments.begin.python",

            // )
            "punctuation.definition.arguments.end.python",
            "meta.item-access.python",


            // {
            "punctuation.definition.dict.begin.python",

            // }
            "punctuation.definition.dict.end.python",
            "meta.member",
            "meta.member.access",
            "meta.member.access.python",
          ],
          "settings": { "foreground": "#028080" }
        },
        {
          "scope": [
            // =
            "keyword.operator.assignment.python"
          ],
          "settings": { "foreground": "#af5f00" }
        },
        {
          "scope": [
            "constant.character.format.placeholder.other.python",
            "meta.format.percent.python"
          ],
          "settings": { "foreground": "#9164ff" }
        },
        {
          "scope": [
            "support.type.exception",
            "support.type.exception.python"
          ],
          "settings": { "foreground": "#ff7f00" }
        },
        {
          "scope": [
            "entity.name.function.decorator.python",
            "meta.function.decorator.python"
          ],
          "settings": { "foreground": "#9164ff" }
        }
      ]
    },
