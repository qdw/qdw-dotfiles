# -*- mode: gitconfig -*-
# -*- eval: (indent-tabs-mode 1) -*-

[github]
	user = qdw

[user]
	email = quinn.weaver@upstart.com
	name = Quinn Weaver

[includeIf "gitdir:~/upst"]
	path = ~/.upstart-gitconfig

[includeif "gitdir:blue-shaper"]
	path = ~/.blue-shaper-gitconfig



[blame]
	coloring = highlightRecent

[color "diff"]
	meta = magenta
	old = "#ac4d4d"
	new = "#3b8560"
	oldMoved = brightblack
	newMoved = brightblue
	oldMovedAlternative = cyan
	newMovedAlternative = brightcyan

[color "blame"]
	highlightRecent = 22,6.months.ago,28,3.months.ago,34,6.weeks.ago,40,3.weeks.ago,47,10.days.ago,120

[core]
	excludesFile = /Users/quinn.weaver/.config/git/ignore
	ignorecase = false
	## whitespace = space-before-tab,tab-in-indent
	
## [log]
	## ignoreAllSpace
	## ignoreSpaceAtEol

[diff]
	## ignoreBlankLines
	## ignoreSpaceAtEol
	algorithm = patience
	color = always
	colorMoved = dimmed-zebra
	## difft: semantic diff that understands various programming languages
	## tool = difft #--background dark --color always --missing-as-empty --skip-unchanged


[difftool]
	prompt = false
	
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
	
[pager]
	difftool = true

[merge]
	tool = emerge
	renamelimit = 10500

[alias]
	added = diff --diff-filter=A	
	branch = branch --quiet
	char-diff = diff --word-diff-regex=.
	co = switch
	prev = "!f() { local FILE=\"$HOME/tmp/$(basename $(git rev-parse --show-toplevel))-$(basename $(tty))\"; echo \"old: \"$(cat $FILE)\"; new: $1\"; /bin/echo \"$1\" > \"$FILE\"; }; f "
	comp = diff --compact-summary
	delete-remote-branch = push origin --delete
	diff-remote = diff @{u}
	diff-remote-committed = diff @{u} HEAD
	dry = merge --no-commit --no-ff
	ff = pull --ff-only
	ignored = "!f() { /bin/echo -n \"$1\" 'is'; git check-ignore --quiet \"$1\"; if [[ $? = 1 ]]; then /bin/echo -n ' not'; fi; /bin/echo ' ignored by git'; }; f "
	main = "!f() { git switch "$(get-main-branch-name)"; }; f "
    master = main
	em = commit --allow-empty-message -m ''
	no = diff --name-only
	s = status
	stat = status
	tg = "!f() { git tag | sort -g; }; f "
	tree = log --graph --decorate --pretty=oneline --abbrev-commit
	try = "!f() { git add . && git commit --allow-empty-message -m '' && git push; }; f"
	unadd = restore --staged
	report = log --pretty='----------------------------------------------------------------------------%n%s%w(0,4,4)%b'
	weekly-report = log --since='7 days' --pretty='----------------------------------------------------------------------------%n%s%w(0,4,4)%b'

[init]
	defaultBranch = main

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[push]
	autoSetupRemote = on

[advice]
	diverging = false
