-- -*- mode: sql -*-

-- -- Important semantics

\set ON_ERROR_ROLLBACK interactive
\set HISTSIZE -1
\set statement_timeout = 0;
\set idle_session_timeout = '2 days';
\set idle_in_transaction_session_timeout = '5 minutes';

-- -- Output formatting

\x auto
\pset null '        [NULL]'
-- \pset null 🐙
-- \set QUIET on

-- -- Prompt

SELECT CASE WHEN pg_is_in_recovery() THEN 'replica 💧' ELSE 'PRIMARY ⚠️' END
       AS sigil \gset
\set PROMPT1 '🐘 %n@%m:%/ %:sigil: %# '
