-- -*- mode: sql -*-

-- Important semantics

\set ON_ERROR_ROLLBACK interactive
\set HISTSIZE -1
\set statement_timeout = 0;
\set idle_session_timeout = '2 days';
\set idle_in_transaction_session_timeout = '5 minutes';

-- Appearance

-- \set QUIET on
\x auto
\pset null 🐙

-- ANSI color escape codes don't play well with libedit, which macOS
-- uses instead of libreadline; ditto Unicode chars.
\set PROMPT1 '[%/] %n@%m%#  '
