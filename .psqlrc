-- -*- mode: sql -*-

-- ---- Important semantics

\set ON_ERROR_ROLLBACK interactive
\set HISTSIZE -1
\set statement_timeout = 0;
\set idle_session_timeout = '2 days';
\set idle_in_transaction_session_timeout = '5 minutes';

-- ---- Output formatting

\x auto
\pset null '[NULL]'
-- \pset null 🐙
-- \set QUIET on

-- ---- Prompt

-- Customize my prompt to reassure me when I'm on a replica (read-only)
-- and warn me when I'm on a primary (writeable!)

---- Unfortunately, both emoji and ANSI SGR colors cause readline to wrap
---- lines wrong, which makes writing queries hard. So use plain ASCII for now.

SELECT
CASE WHEN inet_client_addr() IS NULL
    THEN ''
ELSE
    CASE WHEN pg_is_in_recovery()
        -- green text; chr(27) is the ESC character, used for ANSI SGR color
        THEN ' 💧%[' || chr(27) || '[32m%]replica' || chr(27) || '[0m%]💧'
    ELSE
        -- red text with emoji
        -- ' ⚠️%[' || chr(27) || '[31m%]PRIMARY' || chr(27) || '[0m%]⚠️'

        -- red text without emoji
        -- chr(27) || '[31m%]PRIMARY' || chr(27) || '[0m%]️'

        -- colorless text
        '!!! PRIMARY !!!'
    END
END
AS replication_role_marker \gset

-- ---- psql built-in escape codes:
-- %n - (n)ame of user
-- %m - (m)achine, that is, host (for Unix domain sockets, will be '[local]')
-- %/ - database, e.g. 'postgres'
-- %# - '#' if logged in as a role with SUPERUSER; '>' otherwise.

-- Full prompt with emoji
-- \set PROMPT1 '🐘 %n@%m:%/' :replication_role_marker ' %# '

-- Full prompt without emoji
\set PROMPT1 '%n@%m:%/ ' :replication_role_marker ' %# '
